# Copy to .env.local. Never use a NEXT_PUBLIC_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FINNHUB_API_KEY=
FOOTBALL_DATA_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
# Cloud providers need their own API key. Select grok, gemini, or ollama.
AI_PROVIDER=ollama
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Ollama needs no API key; blank uses the first installed local model.
OLLAMA_MODEL=qwen3:1.7b
