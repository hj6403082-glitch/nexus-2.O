# Copy to .env.local. Never use a NEXT_PUBLIC_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FINNHUB_API_KEY=
FOOTBALL_DATA_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
