# Copy to .env.local. Never use a NEXT_PUBLIC_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FINNHUB_API_KEY=
FOOTBALL_DATA_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
# Cloud providers need their own API key. Select grok, gemini, or ollama.
AI_PROVIDER=ollama
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Ollama needs no API key; blank uses the first installed local model.
OLLAMA_MODEL=qwen3:1.7b
# Premium voice (Phase 8). Default provider is ElevenLabs; without a key NEXUS
# uses the browser's built-in speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Windows bridge (Phase 8). The bridge prints its own token at launch; set these
# only to override the defaults.
NEXUS_BRIDGE_PORT=4517
