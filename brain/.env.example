# Copy to brain/.env. Every setting is optional except the model path.
ZENO_MODEL_PATH=models/your-chat-model.gguf
ZENO_CONTEXT_SIZE=4096
# 0 = CPU only. -1 = every layer on the GPU (needs the CUDA build, see CLAUDE.md).
ZENO_GPU_LAYERS=0
# ZENO_THREADS=8
ZENO_MAX_TOKENS=700
ZENO_TEMPERATURE=0.7
ZENO_MAX_QUEUE=4
