# Copy to brain/.env. Every setting is optional except the model path.
ZENO_MODEL_PATH=models/your-chat-model.gguf
ZENO_CONTEXT_SIZE=4096
# 0 = CPU only. -1 = every layer on the GPU (needs the CUDA build, see CLAUDE.md).
ZENO_GPU_LAYERS=0
# ZENO_THREADS=8
ZENO_MAX_TOKENS=700
ZENO_TEMPERATURE=0.7
ZENO_MAX_QUEUE=4

# Long-term memory (ChromaDB, stored locally, telemetry off).
ZENO_MEMORY_DIR=data/memory
# A GGUF embedding model such as nomic-embed-text.
ZENO_EMBEDDING_MODEL_PATH=models/your-embedding-model.gguf
ZENO_MEMORY_MIN_SIMILARITY=0.35
ZENO_EPISODE_HALF_LIFE_DAYS=30
ZENO_WORKING_MEMORY_MESSAGES=20

# Senses: WebSocket server for edge devices. v1 only listens on this PC.
ZENO_SENSES_HOST=127.0.0.1
ZENO_SENSES_PORT=8765
ZENO_DEVICES_FILE=data/devices.json
ZENO_HEARTBEAT_INTERVAL=10
ZENO_HEARTBEAT_TIMEOUT=30

# Agent (ReAct tool use). State-changing tools always wait for your approval.
ZENO_AGENT_MAX_STEPS=5
ZENO_AGENT_MAX_IDENTICAL_CALLS=2
ZENO_AGENT_APPROVAL_TIMEOUT=120
ZENO_AGENT_MAX_OBSERVATION_CHARS=2000
ZENO_AUDIT_LOG_PATH=data/audit/agent.jsonl
ZENO_SCRIPTS_DIR=scripts
ZENO_SCRIPT_TIMEOUT=30
ZENO_SCRIPT_MAX_OUTPUT=4000

# Chat API (python -m zeno). Same 127.0.0.1 server as the device socket.
# The bearer token is created here on first start; print it with `python -m zeno token`.
ZENO_API_TOKEN_FILE=data/api-token
# Browser pages allowed to open the chat socket, as a JSON list. Empty: none.
ZENO_API_ALLOWED_ORIGINS=[]
ZENO_CHAT_MAX_CHARS=4000

# Phase 2 tools. Each reaches beyond this PC, so each is off until you turn it on.
ZENO_NETWORK_TOOLS=false
# Your SearXNG instance (with JSON output enabled). Unset: no web search.
# ZENO_WEB_SEARCH_URL=http://127.0.0.1:8888
ZENO_WEB_FETCH=false
ZENO_WEB_FETCH_ALLOW_LAN=false
ZENO_WEB_FETCH_MAX_BYTES=2000000
ZENO_WEB_FETCH_TIMEOUT=10
# ssh_run: copy examples/ssh_hosts.example.json here. No file, no SSH.
ZENO_SSH_HOSTS_FILE=data/ssh_hosts.json
ZENO_SSH_COMMAND_TIMEOUT=20
ZENO_SSH_MAX_OUTPUT=4000
# MQTT: copy examples/mqtt.example.json here. No file, no MQTT.
ZENO_MQTT_FILE=data/mqtt.json
# ZENO_MQTT_PASSWORD=   (only if your mqtt.json names it in password_env)
